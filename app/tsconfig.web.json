{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "esModuleInterop": true, "composite": true, "noEmit": true,
    "baseUrl": ".", "paths": { "@/*": ["src/renderer/*"] }, "types": ["vite/client"]
  },
  "include": ["src/renderer/**/*", "src/preload/*.d.ts", "test/**/*"]
}
